# Copy to .env for a local PostgreSQL-backed run. Values are never rendered by the web UI.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
COLLECTOR_PORT=3001
DATABASE_URL=postgresql://tracegarden:local-only@127.0.0.1:5432/tracegarden
# DATABASE_MODE=memory is for credential-free HTTP smoke tests only.
