# Copy to .env for a local PostgreSQL-backed run. Values are never rendered by the web UI.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
COLLECTOR_PORT=3001
DATABASE_URL=postgresql://tracegarden:local-only@127.0.0.1:5432/tracegarden
# DATABASE_MODE=memory is for credential-free HTTP smoke tests only.
# Production uses Better Auth with Google OAuth; these are required only when NODE_ENV=production.
# BETTER_AUTH_SECRET=
# TIMELINE_CURSOR_SECRET=
# BETTER_AUTH_URL=https://tracegarden.example
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://tracegarden.example/api/auth/callback/google
# TRACEGARDEN_BOOTSTRAP_ISSUER=https://accounts.google.com
# TRACEGARDEN_BOOTSTRAP_SUBJECT=  # Google's stable OIDC sub, never an email
# In production, both adapters use their distinct automounted in-cluster ServiceAccount tokens.
# KUBERNETES_API_SERVER=https://kubernetes.example:6443
# KUBERNETES_LOG_API_SERVER=https://kubernetes.example:6443
