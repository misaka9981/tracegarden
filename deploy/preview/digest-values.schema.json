{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["images"],
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "collector", "migrate", "postgres"],
      "properties": {
        "web": { "$ref": "#/definitions/privateImage" },
        "collector": { "$ref": "#/definitions/privateImage" },
        "migrate": { "$ref": "#/definitions/privateImage" },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": { "const": "postgres" },
            "digest": { "const": "sha256:54451ecb8ab38c24c3ec123f2fd501303a3a1856a5c66e98cecf2460d5e1e9d7" }
          }
        }
      }
    }
  },
  "definitions": {
    "privateImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "pattern": "^ghcr.io/misaka3389/tracegarden-(web|collector|migrate)$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
