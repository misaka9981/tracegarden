{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["images", "web", "collector", "migration", "postgres", "config", "secrets", "serviceAccount", "rbac", "service", "ingress", "networkPolicy"],
  "properties": {
    "nameOverride": { "$ref": "#/definitions/kubernetesName" },
    "fullnameOverride": { "$ref": "#/definitions/kubernetesName" },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "collector", "migrate", "postgres"],
      "properties": {
        "web": { "$ref": "#/definitions/image" },
        "collector": { "$ref": "#/definitions/image" },
        "migrate": { "$ref": "#/definitions/image" },
        "postgres": { "$ref": "#/definitions/image" }
      }
    },
    "web": { "$ref": "#/definitions/application" },
    "collector": { "$ref": "#/definitions/application" },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backoffLimit", "activeDeadlineSeconds", "databaseReadyTimeoutSeconds", "databaseReadyRetrySeconds", "schemaReadyTimeoutSeconds", "schemaReadyRetrySeconds", "resources"],
      "properties": {
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "databaseReadyTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "databaseReadyRetrySeconds": { "type": "integer", "minimum": 1 },
        "schemaReadyTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "schemaReadyRetrySeconds": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "username", "port", "persistence", "resources"],
      "properties": {
        "database": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
        "username": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "storageClass"],
          "properties": {
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$" },
            "storageClass": { "type": "string", "maxLength": 63 }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["betterAuthUrl", "googleClientId", "googleRedirectUri", "bootstrapIssuer", "bootstrapSubject", "observationApiServer", "logApiServer", "retentionCleanupIntervalMs"],
      "properties": {
        "betterAuthUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "googleClientId": { "type": "string", "minLength": 1 },
        "googleRedirectUri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "bootstrapIssuer": { "type": "string", "enum": ["https://accounts.google.com"] },
        "bootstrapSubject": { "type": "string", "minLength": 1 },
        "observationApiServer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "logApiServer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "retentionCleanupIntervalMs": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "application", "google"],
      "properties": {
        "database": {
          "type": "object", "additionalProperties": false, "required": ["existingSecret", "urlKey", "passwordKey"],
          "properties": {
            "existingSecret": { "$ref": "#/definitions/secretName" },
            "urlKey": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        },
        "application": {
          "type": "object", "additionalProperties": false, "required": ["existingSecret", "betterAuthKey", "timelineCursorKey"],
          "properties": {
            "existingSecret": { "$ref": "#/definitions/secretName" },
            "betterAuthKey": { "type": "string", "minLength": 1 },
            "timelineCursorKey": { "type": "string", "minLength": 1 }
          }
        },
        "google": {
          "type": "object", "additionalProperties": false, "required": ["existingSecret", "clientSecretKey"],
          "properties": {
            "existingSecret": { "$ref": "#/definitions/secretName" },
            "clientSecretKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "observationName", "logsName"],
      "properties": {
        "create": { "type": "boolean" },
        "observationName": { "type": "string", "maxLength": 63, "pattern": "^(|[a-z0-9](?:[a-z0-9-]*[a-z0-9])?-observation)$" },
        "logsName": { "type": "string", "maxLength": 63, "pattern": "^(|[a-z0-9](?:[a-z0-9-]*[a-z0-9])?-logs-reader)$" }
      },
      "allOf": [
        {
          "if": { "properties": { "create": { "const": false } } },
          "then": {
            "properties": {
              "observationName": { "minLength": 1 },
              "logsName": { "minLength": 1 }
            }
          }
        }
      ]
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaces", "resourceKinds"],
      "properties": {
        "namespaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/namespace" },
          "uniqueItems": true
        },
        "resourceKinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["Deployment", "StatefulSet", "DaemonSet", "ReplicaSet", "Pod", "Job", "CronJob", "Event"] },
          "uniqueItems": true
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "collector", "postgres"],
      "properties": {
        "web": { "$ref": "#/definitions/service" },
        "collector": { "$ref": "#/definitions/service" },
        "postgres": { "$ref": "#/definitions/service" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "host", "tls", "annotations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string", "minLength": 1 },
        "host": { "$ref": "#/definitions/dnsName" },
        "tls": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "secretName"],
          "properties": { "enabled": { "type": "boolean" }, "secretName": { "$ref": "#/definitions/secretName" } }
        },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlaneCIDRs", "controlPlanePort", "googleOAuthCIDRs", "ingressNamespace", "dnsNamespace", "dnsPodSelector"],
      "properties": {
        "controlPlaneCIDRs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cidr" }, "uniqueItems": true },
        "controlPlanePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "googleOAuthCIDRs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cidr" }, "uniqueItems": true },
        "ingressNamespace": { "$ref": "#/definitions/namespace" },
        "dnsNamespace": { "$ref": "#/definitions/namespace" },
        "dnsPodSelector": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 63 } }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+(?:[./][A-Za-z0-9._-]+)*(?:/[A-Za-z0-9._-]+)*$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourceValues" },
        "limits": { "$ref": "#/definitions/resourceValues" }
      }
    },
    "resourceValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": { "cpu": { "$ref": "#/definitions/cpuQuantity" }, "memory": { "$ref": "#/definitions/memoryQuantity" } }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "port", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": { "type": { "type": "string", "enum": ["ClusterIP"] }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    },
    "kubernetesName": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "dnsName": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$" },
    "secretName": { "$ref": "#/definitions/dnsName" },
    "namespace": { "$ref": "#/definitions/kubernetesName" },
    "cidr": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" },
    "cpuQuantity": { "type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|[0-9]+m)$" },
    "memoryQuantity": { "type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|[0-9]+)(?:Ki|Mi|Gi|Ti|Pi|Ei)?$" }
  }
}
